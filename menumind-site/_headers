# Portable headers file (Netlify / Cloudflare Pages).
# Vercel uses vercel.json instead; this is here so a drag-drop deploy
# to Netlify or CF Pages also serves the APK with the right MIME type.

/MenuMind.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="MenuMind.apk"

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000
